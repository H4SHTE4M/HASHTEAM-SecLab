export PATH=/usr/local/bin:/bin:/usr/bin:/sbin
. /etc/hashteam/colors.sh
if [ "$HT_COLOR_ENABLED" -eq 1 ]; then
    export PS1='\[\033[1;92m\]\u@hashteam\[\033[0m\]:\[\033[1;96m\]\w\[\033[0m\] \[\033[1;97m\]\$\[\033[0m\] '
else
    export PS1='\u@hashteam:\w\$ '
fi
umask 022
# 遥测命令 wrapper：为 allowlist 中的命令注入 /dev/tty 协议上报。
# wrapper 透传 argv/stdin/stdout/stderr/exit code，不影响实验行为。
. /etc/hashteam/telemetry.sh
# alias su/netstat 已由 telemetry.sh 中的 su() 函数覆盖；
# netstat 仍是独立过滤包装器（非遥测目标）。
alias netstat='/usr/local/bin/netstat'
