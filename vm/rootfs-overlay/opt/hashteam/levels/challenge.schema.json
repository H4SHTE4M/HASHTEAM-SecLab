{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HASHTEAM Security Lab Progressive Challenge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "slug",
    "name",
    "tagline",
    "storySummary",
    "story",
    "goals",
    "prerequisites",
    "newConcepts",
    "steps",
    "hints",
    "verification",
    "completionSummary"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "id": { "type": "integer", "minimum": 1 },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": { "$ref": "#/$defs/nonEmptyString" },
    "tagline": { "$ref": "#/$defs/nonEmptyString" },
    "storySummary": { "$ref": "#/$defs/nonEmptyString" },
    "story": { "$ref": "#/$defs/nonEmptyString" },
    "goals": { "$ref": "#/$defs/nonEmptyStringList" },
    "prerequisites": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "newConcepts": { "$ref": "#/$defs/nonEmptyStringList" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "hints": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "kind", "text"],
          "properties": {
            "level": { "const": 1 },
            "kind": { "const": "direction" },
            "text": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "kind", "text"],
          "properties": {
            "level": { "const": 2 },
            "kind": { "const": "tool" },
            "text": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "kind", "text"],
          "properties": {
            "level": { "const": 3 },
            "kind": { "const": "structure" },
            "text": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usage", "instruction", "placeholders", "feedback"],
      "properties": {
        "usage": { "$ref": "#/$defs/nonEmptyString" },
        "instruction": { "$ref": "#/$defs/nonEmptyString" },
        "placeholders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["token", "meaning"],
            "properties": {
              "token": {
                "type": "string",
                "pattern": "^<[^<>\\n]+>$"
              },
              "meaning": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        "feedback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["empty", "incorrect", "success"],
          "properties": {
            "empty": { "$ref": "#/$defs/nonEmptyString" },
            "incorrect": { "$ref": "#/$defs/nonEmptyString" },
            "success": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      }
    },
    "completionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solved", "mastered", "next"],
      "properties": {
        "solved": { "$ref": "#/$defs/nonEmptyString" },
        "mastered": { "$ref": "#/$defs/nonEmptyStringList" },
        "next": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "term", "explanation"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "term": { "$ref": "#/$defs/nonEmptyString" },
        "explanation": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "commandField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "placeholder"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "placeholder": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "choices", "answer", "success"],
      "properties": {
        "prompt": { "$ref": "#/$defs/nonEmptyString" },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/choice" }
        },
        "answer": { "$ref": "#/$defs/nonEmptyString" },
        "success": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "objective",
        "instruction",
        "completion",
        "allowRun"
      ],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "type": {
          "enum": [
            "explain",
            "observe",
            "partial-command",
            "manual-command",
            "question",
            "checkpoint",
            "reflection"
          ]
        },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "objective": { "$ref": "#/$defs/nonEmptyString" },
        "instruction": { "$ref": "#/$defs/nonEmptyString" },
        "completion": {
          "enum": ["acknowledge", "run", "input", "answer", "confirm"]
        },
        "allowRun": { "type": "boolean" },
        "introduces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/concept" }
        },
        "uses": { "$ref": "#/$defs/nonEmptyStringList" },
        "command": { "$ref": "#/$defs/nonEmptyString" },
        "commandTemplate": { "$ref": "#/$defs/nonEmptyString" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/commandField" }
        },
        "observation": { "$ref": "#/$defs/nonEmptyString" },
        "question": { "$ref": "#/$defs/question" },
        "commonErrors": { "$ref": "#/$defs/nonEmptyStringList" },
        "reinforcement": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
