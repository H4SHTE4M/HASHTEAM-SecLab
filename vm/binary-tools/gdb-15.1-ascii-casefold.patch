diff --git a/gdb/ada-lang.c b/gdb/ada-lang.c
index 4f9399c4e4f..b789c7e10bc 100644
--- a/gdb/ada-lang.c
+++ b/gdb/ada-lang.c
@@ -1045,6 +1045,28 @@ ada_fold_name (std::string_view name, bool throw_on_error = false)
   if (!name.empty () && name[0] == '\'')
     fold_storage = name.substr (1, name.size () - 2);
   else
     {
+      /* Static glibc normally loads gconv modules at runtime for UTF-32.
+	 The reduced PwnHub initramfs intentionally has no such dynamic module
+	 tree.  GNAT's rule for ASCII is simply to fold upper-case letters to
+	 lower case, so handle that common symbol path without iconv.  Keep the
+	 existing conversion path for names containing non-ASCII bytes.  */
+      bool ascii_only = true;
+      for (unsigned char c : name)
+	if (c >= 0x80)
+	  {
+	    ascii_only = false;
+	    break;
+	  }
+
+      if (ascii_only)
+	{
+	  fold_storage = name;
+	  for (char &c : fold_storage)
+	    if (c >= 'A' && c <= 'Z')
+	      c += 'a' - 'A';
+	  return fold_storage.c_str ();
+	}
+
       /* Why convert to UTF-32 and implement our own case-folding,
	 rather than convert to wchar_t and use the platform's
	 functions?  I'm glad you asked.
