#!/bin/sh
# 极简 file(1) 替代实现：解析 ELF 识别字段，其他格式按魔数或文本特征分类。
set -u

describe_elf() {
    elf_file="$1"
    set -- $(dd if="$elf_file" bs=1 count=20 2>/dev/null | od -An -tx1)
    if [ "$#" -lt 20 ]; then
        echo "$elf_file: ELF data"
        return
    fi

    case "$5" in
        01) elf_class='32-bit' ;;
        02) elf_class='64-bit' ;;
        *) elf_class="class 0x$5" ;;
    esac
    case "$6" in
        01)
            elf_endian='LSB'
            elf_type_code="${18}${17}"
            elf_machine_code="${20}${19}"
            ;;
        02)
            elf_endian='MSB'
            elf_type_code="${17}${18}"
            elf_machine_code="${19}${20}"
            ;;
        *)
            elf_endian="data encoding 0x$6"
            elf_type_code="${17}${18}"
            elf_machine_code="${19}${20}"
            ;;
    esac
    case "$elf_type_code" in
        0001) elf_type='relocatable' ;;
        0002) elf_type='executable' ;;
        0003) elf_type='shared object' ;;
        0004) elf_type='core file' ;;
        *) elf_type="type 0x$elf_type_code" ;;
    esac
    case "$elf_machine_code" in
        0003) elf_machine='Intel 80386' ;;
        003e) elf_machine='x86-64' ;;
        0028) elf_machine='ARM' ;;
        00b7) elf_machine='AArch64' ;;
        *) elf_machine="machine 0x$elf_machine_code" ;;
    esac

    echo "$elf_file: ELF $elf_class $elf_endian $elf_type, $elf_machine"
}

if [ $# -eq 0 ]; then
    echo "用法：file <文件...>" >&2
    exit 2
fi
for f in "$@"; do
    if [ -d "$f" ]; then
        echo "$f: directory"
        continue
    fi
    if [ ! -r "$f" ]; then
        echo "$f: cannot open (No such file or directory)"
        continue
    fi
    magic=$(dd if="$f" bs=1 count=4 2>/dev/null | od -An -tx1 | tr -d ' \n')
    case "$magic" in
        7f454c46*) describe_elf "$f"; continue ;;
        1f8b*)     echo "$f: gzip compressed data"; continue ;;
        25504446*) echo "$f: PDF document"; continue ;;
        504b*)     echo "$f: Zip archive data"; continue ;;
    esac
    # 存在控制字符（除 \t \n \r）→ 二进制 data；否则文本
    if [ -n "$(tr -d '\t\n\r\040-\176\200-\377' < "$f" | head -c 1)" ]; then
        echo "$f: data"
    elif [ -n "$(tr -d '\000-\177' < "$f" | head -c 1)" ]; then
        echo "$f: UTF-8 Unicode text"
    else
        echo "$f: ASCII text"
    fi
done
