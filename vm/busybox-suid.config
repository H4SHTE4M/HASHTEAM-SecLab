# BusyBox 1.38.0 minimal SUID helper.
#
# The build applies this fragment on top of allnoconfig, so every applet not
# explicitly enabled here stays disabled.  It also verifies the final applet
# list before the binary can enter the initramfs.
CONFIG_SHOW_USAGE=y
CONFIG_BUSYBOX=y
CONFIG_STATIC=y
CONFIG_STATIC_LIBGCC=y
CONFIG_EXTRA_CFLAGS="-fstack-protector-strong -D_FORTIFY_SOURCE=2"
CONFIG_EXTRA_LDFLAGS="-Wl,-z,relro,-z,now"

# Enforce each applet's BB_SUID_* policy.  Runtime /etc/busybox.conf overrides
# intentionally remain disabled: the compiled-in su policy is enough.
CONFIG_FEATURE_SUID=y
# CONFIG_FEATURE_SUID_CONFIG is not set

# Static binaries must read the initramfs passwd/group database without NSS
# modules and must be able to verify the password formats supported by BusyBox.
CONFIG_FEATURE_SHADOWPASSWDS=y
CONFIG_USE_BB_PWD_GRP=y
CONFIG_USE_BB_CRYPT=y
CONFIG_USE_BB_CRYPT_SHA=y
CONFIG_USE_BB_CRYPT_YES=y

CONFIG_SU=y

# `passwd` is intentionally excluded.  The current course never changes
# account passwords, and adding another root applet would only widen the
# privilege boundary.
#
# Do not let Kconfig's shell choices add another SUID applet.
# CONFIG_SH_IS_ASH is not set
# CONFIG_SH_IS_HUSH is not set
CONFIG_SH_IS_NONE=y
# CONFIG_BASH_IS_ASH is not set
# CONFIG_BASH_IS_HUSH is not set
CONFIG_BASH_IS_NONE=y
