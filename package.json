{
  "name": "hashteam-web-lab",
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19"
  },
  "private": true,
  "description": "HASHTEAM Security Lab - 浏览器内运行的交互式 Linux 安全新手村",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:challenges": "node scripts/validate-challenges.mjs",
    "validate:binary-profile": "node scripts/validate-binary-profile.mjs",
    "build": "pnpm validate:challenges && pnpm validate:binary-profile && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "pnpm validate:challenges && pnpm validate:binary-profile && vitest run",
    "test:backend": "vitest run --config vitest.backend.config.ts",
    "test:watch": "vitest",
    "test:vm": "pnpm validate:challenges && bash scripts/test-vm-checks.sh",
    "test:binary-profile": "bash scripts/test-binary-profile.sh",
    "test:suid": "python3 scripts/verify-suid-initramfs.py public/vm/rootfs.cpio.gz",
    "test:integration": "pnpm validate:challenges && node scripts/integration-test.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "build:vm": "sh vm/build.sh"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "v86": "^0.5.424",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "edgeone": "1.6.18",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.4",
    "vue-tsc": "^2.2.8"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<=5.0.7": "5.0.8",
      "nanoid@<3.3.18": "3.3.18"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
