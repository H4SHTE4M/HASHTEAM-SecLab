    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.4",
    "vue-tsc": "^2.2.8"
  }
}
