{
  "name": "hashteam-web-lab",
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "private": true,
  "description": "HASHTEAM Security Lab - 浏览器内运行的交互式 Linux 安全新手村",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
